BLOOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Postgres connection string.
# Use the SESSION pooler (port 5432) for long-lived servers like Render.
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Public URL of the Next.js frontend (used for confirm/unsubscribe redirects).
PUBLIC_WEB_URL=http://localhost:3000

# Public URL of this API (used inside daily emails for the unsubscribe link).
PUBLIC_API_URL=http://localhost:8000

# Resend transactional-email credentials.
# Sandbox sender 'onboarding@resend.dev' only delivers to your Resend account email.
# Use a verified domain sender for arbitrary recipients.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Random secret protecting internal endpoints (/internal/tick, /internal/test-email).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TICK_SECRET=
